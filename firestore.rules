
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin or has HR role
    function isAdmin(userId) {
      let userRole = get(/databases/$(database)/documents/employee/$(userId)).data.role;
      return userRole == 'admin' || userRole == 'hr' || userRole == 'director'
      || userRole == 'Human Resource Director' || userRole == 'human resource director'
      || userRole == 'Human Resource Director International Schools' || userRole == 'human resource director international schools'
      || userRole == 'Personnal Director' || userRole == 'personnal director'
      || userRole == 'Recruitment and Onboarding Manager' || userRole == 'recruitment and onbording manager' || userRole == 'recruitment and onboarding manager'
      || userRole == 'Human Resource Executive' || userRole == 'human resource executive'
      || userRole == 'Recruitment and Onboarding Executive' || userRole == 'recruitment and onboarding executive'
      || userRole == 'Personnel Executive' || userRole == 'personnel executive';
    }
    
    // Employee collection:
    // - Authenticated users can read their own profile.
    // - Admins can read/write any profile.
    match /employee/{employeeId} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
      allow read: if request.auth != null && exists(/databases/$(database)/documents/employee/$(employeeId)) && get(/databases/$(database)/documents/employee/$(employeeId)).data.userId == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Jobs collection:
    // - Anyone can read (list and get) jobs.
    // - Only authenticated admins can create, update, or delete jobs.
    match /jobs/{jobId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    // Job Applications:
    // - Anyone can create (submit) an application.
    // - Only admins can read applications.
    match /jobApplications/{applicationId} {
      allow create: if true;
      allow read, write, delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Document Requests:
    // - Authenticated users can create requests and read their own requests.
    // - Admins and HR can read, update, and manage all document requests.
    match /documentRequests/{requestId} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid || resource.data.requestingEmployeeDocId == request.auth.uid);
    }

    // All other collections are locked down by default and require admin access.
    match /{document=**} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }
  }
}
